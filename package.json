{
  "name": "curriculym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed:catalog": "npx tsx prisma/seed-catalog.ts",
    "db:up": "pg_ctl -D \"$HOME/Library/Application Support/curriculym-postgres\" -l \"$HOME/Library/Application Support/curriculym-postgres/server.log\" -o \"-p 5432\" start || true",
    "db:down": "pg_ctl -D \"$HOME/Library/Application Support/curriculym-postgres\" stop || true",
    "db:status": "pg_isready -h localhost -p 5432"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@clerk/ui": "^1.32.2",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
